// Phase 2 adds the ingestion entities the worker needs: Image, Job, Person, FaceDetection.
// No embedding/pgvector and no ImageTag yet — the face backend is the only AI source today; add those
// when object-detection / embedding backends exist. ponytail: don't scaffold columns nothing populates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Per-image queue state. The worker claims PENDING rows (FOR UPDATE SKIP LOCKED) in Phase 2 Slice 4.
enum ImageStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folders   Folder[]
}

model Folder {
  id               String    @id @default(cuid())
  graphDriveId     String
  graphItemId      String
  webUrl           String
  name             String
  isPublicOverride Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdById      String
  createdAt        DateTime  @default(now())
  images           Image[]
  jobs             Job[]

  @@unique([graphDriveId, graphItemId])
}

// One ingestion run for a folder (re-scans create new jobs). Worker updates the counters live for SSE.
model Job {
  id             String    @id @default(cuid())
  folder         Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId       String
  status         JobStatus @default(PENDING)
  totalItems     Int       @default(0)
  processedItems Int       @default(0)
  failedItems    Int       @default(0)
  errorLog       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Image {
  id           String          @id @default(cuid())
  graphItemId  String          @unique // dedup across re-scans
  folder       Folder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String
  fileName     String
  mimeType     String
  sizeBytes    Int?
  width        Int? // original px (Graph image facet) — needed to scale face boxes onto thumbnails
  height       Int?
  capturedAt   DateTime? // from EXIF
  latitude     Float?
  longitude    Float?
  locationName String?
  webUrl       String
  status       ImageStatus     @default(PENDING) // queue state
  error        String?
  processedAt  DateTime?
  createdAt    DateTime        @default(now())
  faces         FaceDetection[]
  archivedFaces ArchivedFace[]

  @@index([status])
}

// Enrolled people are keyed by the face backend's external_id. name defaults to external_id until edited (Phase 4).
model Person {
  id         String          @id @default(cuid())
  externalId String          @unique
  name       String
  email      String?
  avatarUrl  String?
  isSeeded   Boolean         @default(true)
  // Suppressed from search and from face labels. Durable curation lives here:
  // FaceDetection rows are deleted and recreated on every reprocess, so a
  // per-detection flag would not survive a re-scan. See lib/worker.ts.
  hidden     Boolean         @default(false)
  faces      FaceDetection[]
}

// One detected face box. personId null = unknown (empty matches from the backend). confidence = matches[0].similarity.
// Global key/value config (e.g. permissionMode = OPEN | STRICT).
/// A face region an admin has dismissed: a stranger in the background, or a bad
/// detection. Kept in its own table on purpose — FaceDetection rows are deleted
/// and recreated on every reprocess (see lib/worker.ts), so a flag there would
/// not survive a re-match. Matched back to detections by box overlap, and
/// reversible, which is the whole point of archiving rather than deleting.
model ArchivedFace {
  id        String   @id @default(cuid())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId   String
  boxX      Int
  boxY      Int
  boxWidth  Int
  boxHeight Int
  createdAt DateTime @default(now())

  @@index([imageId])
}

/// A local mirror of the recognition Space's enrolled collection, pulled from
/// /faces. Avatars are often enrolled on the Space directly, so PicScope has to
/// be able to fetch the references rather than only capture what it enrolled
/// itself. `id` is the Space's own face_id, which makes syncing an upsert and
/// makes references deleted upstream detectable.
model ReferenceFace {
  id         String                    @id
  externalId String
  confidence Float?
  embedding  Unsupported("vector(512)")
  syncedAt   DateTime                  @default(now())

  @@index([externalId])
}

model SystemSetting {
  key   String @id
  value String
}

model FaceDetection {
  id         String   @id @default(cuid())
  image      Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId    String
  person     Person?  @relation(fields: [personId], references: [id])
  personId   String?
  boxX       Int
  boxY       Int
  boxWidth   Int
  boxHeight  Int
  confidence Float?
  createdAt  DateTime @default(now())
  /// ArcFace 512-d, L2-normalised — the same vector the Space computes and used
  /// to discard. Persisting it means re-matching against a changed collection
  /// is a SQL query, instead of re-downloading and re-detecting every image.
  /// Prisma has no vector type, so this is read and written via raw SQL only.
  embedding  Unsupported("vector(512)")?
}

# Copy to .env.local and fill in. .env* is gitignored.

# --- Database (Postgres) ---
# Neon scales to zero when idle; its cold-start wake can exceed Prisma's default 5s connect timeout.
# Always include connect_timeout=15 (absorb the wake) and pgbouncer=true (Neon pooler runs PgBouncer).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15&pgbouncer=true"

# --- NextAuth / Auth.js ---
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the app (http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (App Registration) ---
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# --- App bootstrap ---
# This email becomes OWNER on first sign-in.
OWNER_EMAIL=""

# --- Hugging Face face-recognition Space (private) ---
# Token with read access to the Space (https://huggingface.co/settings/tokens).
HF_TOKEN=""
# The private Gradio Space that runs face detection + identification.
HF_SPACE="sakethbejadi/face-recognition"
# The enrolled collection to identify indexed faces against (the group your people are enrolled in).
HF_COLLECTION=""
# /search similarity threshold (Space default 0.35). Lower = more (looser) matches.
HF_THRESHOLD="0.35"
